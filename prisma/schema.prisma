generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Stock {
  ticker          String   @id
  name            String
  sector          String
  industry        String
  price           Float
  change          Float
  changePercent   Float
  volume          Float
  avgVolume3M     Float
  marketCap       Float
  pe              Float // P/E
  forwardPe       Float // Forward P/E
  eps             Float // EPS
  rsi14           Float // RSI (14)
  sma20           Float // SMA (20)
  sma50           Float // SMA (50)
  sma200          Float // SMA (200)
  macdLine        Float // MACD Line
  macdSignal      Float // MACD Signal
  atr             Float // ATR (Average True Range)
  beta            Float // Beta
  high52Week      Float // 52 Week High
  low52Week       Float // 52 Week Low
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  prices          StockPrice[]
  recommendations Recommendation[]
  newsArticles    NewsArticle[]

  @@index([sector])
  @@index([marketCap])
}

model StockPrice {
  id        String   @id @default(uuid())
  symbol    String
  date      DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  createdAt DateTime @default(now())

  stock Stock @relation(fields: [symbol], references: [ticker], onDelete: Cascade)

  @@unique([symbol, date])
  @@index([symbol, date])
  @@index([date])
}

model Recommendation {
  id             String   @id @default(uuid())
  symbol         String
  recommendation String
  confidence     Int
  technical      String
  fundamental    String
  sentiment      String
  summary        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stock Stock @relation(fields: [symbol], references: [ticker], onDelete: Cascade)

  @@index([symbol, createdAt])
}

model NewsArticle {
  id        String   @id @default(uuid())
  symbol    String
  headline  String
  summary   String?
  source    String?
  url       String?
  datetime  DateTime
  createdAt DateTime @default(now())

  stock Stock @relation(fields: [symbol], references: [ticker], onDelete: Cascade)

  @@index([symbol, datetime])
}

model CacheEntry {
  key       String   @id
  value     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
